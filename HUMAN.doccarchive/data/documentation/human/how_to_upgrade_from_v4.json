{"hierarchy":{"paths":[["doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/How_to_upgrade_from_v4"},"abstract":[{"type":"text","text":"There are few changes in the SDK’s API. In this article we will cover all of them."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Bot-Defender","text":"Bot Defender"},{"text":"iOS","anchor":"iOS","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The signature of  "},{"code":"HSBotDefender\/canHandleResponse(response:data:)","type":"codeVoice"},{"type":"text","text":" function was changed to "},{"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSBotDefender\/canHandleBlockResponse(data:)","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The signature of  ","type":"text"},{"type":"codeVoice","code":"HSBotDefender\/handleResponse(response:data:callback:)"},{"text":" function was changed to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSBotDefender\/handleBlockResponse(data:url:callback:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The signature of  "},{"code":"HSBotDefender\/blockResponseError(response:data:)","type":"codeVoice"},{"type":"text","text":" function was changed to "},{"code":"HSBotDefender\/blockError(data:url:)","type":"codeVoice"},{"type":"text","text":" (visionOS)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"HSChallengeModelViewHelper\/registerError(error:uuid:callback:)","type":"codeVoice"},{"type":"text","text":" function was removed. You should use "},{"code":"H