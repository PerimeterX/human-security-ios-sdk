 was solved\/cancelled."}],"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorType\/interceptAndRetryRequest","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interceptAndRetryRequest","kind":"identifier"}]},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorPolicy/urlSessionDelegate":{"title":"urlSessionDelegate","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/urlSessionDelegate","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/urlsessiondelegate","kind":"symbol","abstract":[{"text":"The ","type":"text"},{"code":"URLSessionDelegate","type":"codeVoice"},{"text":" that should be used by the SDK. Default is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the SDK will be the delegate). The SDK implements ","type":"text"},{"code":"willPerformHTTPRedirection","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"needNewBodyStream","type":"codeVoice"},{"text":" function in the ","type":"text"},{"code":"URLSessionDelegate","type":"codeVoice"},{"text":". However, if your ","type":"text"},{"code":"URLSessionDelegate","type":"codeVoice"},{"text":" implements other functions, like ","type":"text"},{"code":"didReceiveChallenge","type":"codeVoice"},{"text":", then you should provide your own delegate.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"urlSessionDelegate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"URLSessionDelegate","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSURLSessionDelegate"},{"text":"?","kind":"text"}],"navigatorTitle":[{"text":"urlSessionDelegate","kind":"identifier"}]},"doc://com.perimeterx.mobile-sdk/s23CustomStringConvertibleP":{"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/s23CustomString