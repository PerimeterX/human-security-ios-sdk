e},{"type":"text","text":" "},{"type":"text","text":"In those cases you would need to set the timeout of the request to 0 in order to enable the request to return only after the challenge is completed when blocked, without getting a time out error,"},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"urlSessionRequestTimeout"},{"type":"text","text":" will allow you to set the required timeout for the actual request, the default will be set to 60 as the default timeout for URLRequest."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"urlSessionRequestTimeout","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"}],"kind":"symbol","navigatorTitle":[{"text":"urlSessionRequestTimeout","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/urlSessionRequestTimeout","type":"topic","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/urlsessionrequesttimeout","title":"urlSessionRequestTimeout"},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorPolicy/urlSessionQueueDelegate":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"urlSessionQueueDelegate","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSOperationQueue","text":"OperationQueue","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/urlsessionqueuedelegate","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/urlSessionQueueDelegate","navigatorTitle":[{"text":"urlSessionQueueDelegate","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"type":"code