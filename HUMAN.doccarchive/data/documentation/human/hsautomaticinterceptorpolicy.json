ceptedDomains:forAppId:)","role":"symbol","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/set(intercepteddomains:forappid:)","type":"topic","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/set(interceptedDomains:forAppId:)","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"setWithInterceptedDomains:forAppId:","kind":"identifier"}]},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorPolicy/urlSessionDelegate":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"urlSessionDelegate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"URLSessionDelegate","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSURLSessionDelegate"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/urlsessiondelegate","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/urlSessionDelegate","navigatorTitle":[{"text":"urlSessionDelegate","kind":"identifier"}],"title":"urlSessionDelegate","abstract":[{"text":"The ","type":"text"},{"code":"URLSessionDelegate","type":"codeVoice"},{"text":" that should be used by the SDK. Default is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the SDK will be the delegate). The SDK implements ","type":"text"},{"code":"willPerformHTTPRedirection","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"needNewBodyStream","type":"codeVoice"},{"text":" function in the ","type":"text"},{"code":"URLSessionDelegate","type":"codeVoice"},{"text":". However, if your ","type":"text"},{"code":"URLSessionDelegate","type":"codeVoice"},{"text":" implements other functions, like ","type":"text"},{"code":"didReceiveChallenge","type":"codeVoice"},{"text":", then you should provide your own delegate.","type":"text"}],"type":"topic"},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorType/interceptAndRetryRequest":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interceptAndRetryRequest","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/human\/hsautomaticinterceptortype\/interceptandretryrequest","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorType\/interceptAndRetryRequest","navigatorTitle":[{"text":"HSAutomaticInterceptorTypeInterceptAndRetryRequest","kind":"identifier"}],"title":"HSAutomaticInterceptorType.interceptAndRetryRequest","abstract":[{"text":"Same as ","type":"text"},{"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorType\/interceptWithDelayedResponse","type":"reference","isActive":true},{"text":". When the challenge is solved, the SDK will send the original request one more time. Your request’s handler should receive the response from your server without knowing that the request was blocked and sent again. You should note that when the challenge is cancelled or when the second request is also blocked, then the behavior will be the same as the ","type":"text"},{"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorType\/interceptWithDelayedResponse","type":"reference","isActive":true},{"text":". In order to delay the request’s response to your handler until the user interacts with the challenge, you must disable the request’s timeout. Otherwise, your handler will receive a timeout error and you might not know that your request was blocked nor the challenge was solved\/cancelled.","type":"text"}],"type":"topic"},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorPolicy/interceptorType":{"abstract":[],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interceptorType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"HSAutomaticInterceptorType","kind":"typeIdentifier","preciseIdentifier":"c:@M@HUMAN@E@HSAutomaticInterceptorType"}],"role":"symbol","navigatorTitle":[{"text":"interceptorType","kind":"identifier"}],"type":"topic","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/interceptortype","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/interceptorType","kind":"symbol","title":"interceptorType"},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorPolicy/urlSessionQueueDelegate":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"urlSessionQueueDelegate","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSOperationQueue","text":"OperationQueue","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/urlsessionqueuedelegate","identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/urlSessionQueueDelegate","navigatorTitle":[{"text":"urlSessionQueueDelegate","kind":"identifier"}],"title":"urlSessionQueueDelegate","abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"OperationQueue"},{"text":" that should be used by the SDK.","type":"text"}],"type":"topic"},"doc://com.perimeterx.mobile-sdk/documentation/HUMAN/HSAutomaticInterceptorPolicy/urlSessionConfiguration":{"identifier":"doc:\/\/com.perimeterx.mobile-sdk\/documentation\/HUMAN\/HSAutomaticInterceptorPolicy\/urlSessionConfiguration","role":"symbol","navigatorTitle":[{"text":"urlSessionConfiguration","kind":"identifier"}],"title":"urlSessionConfiguration","url":"\/documentation\/human\/hsautomaticinterceptorpolicy\/urlsessionconfiguration","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":